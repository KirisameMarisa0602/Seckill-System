# 环境变量模板。复制为 `.env` 后填真实值，切勿提交 `.env`。
# 本地直连与 compose.yml 共用这些键名；支付宝回调 URL 需与公网入口一致。

# MySQL。本地可把 useSSL 设为 true；Compose 内网用 allowPublicKeyRetrieval。
DB_URL=jdbc:mysql://127.0.0.1:3306/seckill?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=true
DB_USERNAME=seckill_app
DB_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace-with-a-strong-password

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=seckill_app
RABBITMQ_PASSWORD=replace-with-a-strong-password

# 沙箱/正式支付宝。NOTIFY_URL 必须公网可达，RETURN_URL 指向前端支付结果页。
ALIPAY_APP_ID=replace-me
ALIPAY_SELLER_ID=replace-me
ALIPAY_PRIVATE_KEY=replace-me
ALIPAY_PUBLIC_KEY=replace-me
ALIPAY_NOTIFY_URL=https://example.com/api/pay/notify
ALIPAY_RETURN_URL=https://example.com/success

# 仅库中无管理员时写入引导账号；密码至少 12 位。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
CORS_ALLOWED_ORIGINS=https://example.com
TRUSTED_PROXIES=127.0.0.1,::1
